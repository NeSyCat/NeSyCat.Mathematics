#!/usr/bin/env bash
# scripts/git-hooks/commit-msg — the feedback-loop absolute blocker.
#
# Law (FORMALIZE.md / Faithfulness / the blueprint<->Lean correspondence):
# touching a Lean declaration that a blueprint item cites via \lean{}
# closes that item's Lean side, and per the post-\leanok work-loop step
# the blueprint text must then be tightened against the formalized form.
# This hook makes that duty a hard commit-time gate rather than a hoped-for
# habit.
#
# Rejects the commit (exit 1) when ALL of the following hold:
#   - the STAGED diff touches a NeSyCat/**.lean file that declares a name
#     cited by a \lean{...} mark in blueprint/src/content.tex,
#   - blueprint/src/content.tex is NOT itself staged in this commit, and
#   - the commit message contains no line starting with "Blueprint-sync:".
#
# Two ways to satisfy the law:
#   1. Stage the corresponding blueprint/src/content.tex edit alongside the
#      Lean change (the normal case: the item's text is now tightened).
#   2. If the Lean edit truly does not change anything the blueprint text
#      needs to reflect (e.g. a whitespace/comment-only edit, a golf pass
#      with no statement change), add a commit-message line starting
#      "Blueprint-sync: <reason>" documenting the justified skip -- the
#      same convention as the never-lose-work line-count-rule justified
#      decrease.
#
# SECOND LAW appended (C2-E6, USER DECREE 2026-08-09, STRUCTURE-MIRROR
# ENFORCEMENT): the blueprint's \section/\subsection tree and the
# NeSyCat/ folder tree must mirror each other exactly -- every
# \section/\subsection carries a trailing `% lean-dir: <path>` tag
# (Introduction alone may opt out with `% lean-dir: -`), every tagged
# path must exist as a NeSyCat/ folder, and every NeSyCat/ folder must
# be tagged by some section. Pure text + filesystem (no Lean, no
# scripts/blueprint.sh dependency -- this hook must stay fast and
# self-contained), checked against the WORKING TREE (which is what is
# about to be committed). A mismatched tree blocks the commit
# unconditionally -- no Blueprint-sync escape hatch, since a stale tree
# is never a "nothing to reflect" case.
#
# Installed as .git/hooks/commit-msg (copy of this file, chmod +x) --
# see /nesycat-math's preflight, which checks the install and instructs
# how to (re)do it if missing/stale.
#
# C2-H2 item 5 AUDIT NOTE: the plugin twin's feedback-loop file-detection
# (LAW 1) used to match a bare `*.lean` pathspec with no root-scoping,
# counting a vendored .lean tree (this repo's own `references/lean-docs`,
# 496 files) as "Lean source changed" and diluting the check into noise;
# its structure-mirror auto-discovery (LAW 2) suffered the same
# contamination via ambiguity. THIS hook is unaffected by either failure
# mode: LAW 1 below already scopes to the literal `NeSyCat/*.lean`
# pathspec (never `references/`), and LAW 2 already hardcodes
# `$REPO_ROOT/NeSyCat` rather than auto-discovering a root. No change was
# needed here; the plugin twin was brought in line with this hook's
# existing scoping instead (see plugin/nesycat-lean4-harness/hooks/
# commit-msg's own file-level comment for the fix).
#
# Args: $1 = path to a file containing the proposed commit message.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." >/dev/null 2>&1 && pwd)"
cd "$REPO_ROOT"

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  # Can't inspect the message; don't block on a plumbing error.
  exit 0
fi

command -v python3 >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

CONTENT_TEX="$REPO_ROOT/blueprint/src/content.tex"
[ -f "$CONTENT_TEX" ] || exit 0  # nothing to enforce against.

# LAW 2: STRUCTURE-MIRROR (C2-E6, USER DECREE 2026-08-09). Runs
# unconditionally (independent of the feedback-loop law above and its
# exit-0 short-circuits) against the working tree.
python3 - "$CONTENT_TEX" "$REPO_ROOT/NeSyCat" << 'PYEOF'
import os
import re
import sys

content_tex, nesycat_root = sys.argv[1], sys.argv[2]

STRUCTURE_MIRROR_RE = re.compile(
    r"^\\(section|subsection)\{([^}]*)\}"
    r"(?:\s*%\s*lean-dir:\s*(\S+))?\s*$")

violations = []
declared = set()
with open(content_tex, encoding="utf-8", errors="replace") as fh:
    for line in fh:
        m = STRUCTURE_MIRROR_RE.match(line.rstrip("\n"))
        if not m:
            continue
        kind, title, tag = m.groups()
        if tag is None:
            violations.append(
                f"untagged section: \\{kind}{{{title}}} carries no "
                "'% lean-dir: <FolderName>' tag")
            continue
        if tag == "-":
            if title != "Introduction":
                violations.append(
                    f"'% lean-dir: -' opt-out used by \\{kind}{{{title}}}, "
                    "but only the Introduction may opt out")
            continue
        declared.add(tag)
        folder = os.path.join(nesycat_root, tag)
        if not os.path.isdir(folder):
            violations.append(
                f"tagged-but-missing folder: \\{kind}{{{title}}} tags "
                f"'{tag}' but NeSyCat/{tag}/ does not exist")

if os.path.isdir(nesycat_root):
    for dirpath, dirnames, _filenames in os.walk(nesycat_root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        rel = os.path.relpath(dirpath, nesycat_root)
        if rel == ".":
            continue
        rel = rel.replace(os.sep, "/")
        if rel not in declared:
            violations.append(
                f"orphan folder: NeSyCat/{rel}/ has no matching "
                "'% lean-dir:' tag in content.tex")

if violations:
    print("commit-msg: STRUCTURE-MIRROR LAW VIOLATED", file=sys.stderr)
    print("", file=sys.stderr)
    print("The blueprint section tree and the NeSyCat/ folder tree have", file=sys.stderr)
    print("drifted apart:", file=sys.stderr)
    for v in violations:
        print(f"  - {v}", file=sys.stderr)
    print("", file=sys.stderr)
    print("Fix content.tex's '% lean-dir:' tags or the NeSyCat/ tree so", file=sys.stderr)
    print("they mirror each other exactly, then redo this commit. No", file=sys.stderr)
    print("Blueprint-sync escape hatch applies to this law.", file=sys.stderr)
    sys.exit(1)
sys.exit(0)
PYEOF
STRUCTURE_MIRROR_STATUS=$?
if [ "$STRUCTURE_MIRROR_STATUS" -ne 0 ]; then
  exit "$STRUCTURE_MIRROR_STATUS"
fi

# 1. Staged Lean files under NeSyCat/, added/copied/modified/renamed.
STAGED_LEAN=()
while IFS= read -r line; do
  [ -n "$line" ] && STAGED_LEAN+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- 'NeSyCat/*.lean' 2>/dev/null)

if [ "${#STAGED_LEAN[@]}" -eq 0 ]; then
  exit 0  # no Lean touched -- law doesn't apply.
fi

# 2. content.tex itself staged -> satisfied.
if git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -qF "blueprint/src/content.tex"; then
  exit 0
fi

# 3. Blueprint-sync: line in the message -> satisfied.
if grep -qE '^Blueprint-sync:' "$MSG_FILE"; then
  exit 0
fi

# 4. Does any staged Lean file declare a name cited by \lean{} in
#    content.tex? Use the STAGED blob content (git show :path), not the
#    working tree, so an unstaged further edit can't hide a violation.
python3 - "$CONTENT_TEX" "${STAGED_LEAN[@]}" << 'PYEOF'
import re
import subprocess
import sys

content_tex = sys.argv[1]
staged_files = sys.argv[2:]

TEX_LABEL_RE = re.compile(r"\\label\{([^}]*)\}")
TEX_LEAN_RE = re.compile(r"\\lean\{([^}]*)\}")
DECL_NAME_RE = re.compile(
    r"^(?:noncomputable\s+|private\s+|protected\s+)*"
    r"(?:def|abbrev|theorem|lemma|structure|class|instance)\s+"
    r"([A-Za-z_][A-Za-z0-9_.']*)")

with open(content_tex, encoding="utf-8", errors="replace") as fh:
    tex_lines = fh.readlines()

lean_index = {}  # name -> label
current_label = None
for line in tex_lines:
    lm = TEX_LABEL_RE.search(line)
    if lm:
        current_label = lm.group(1)
    for m in TEX_LEAN_RE.finditer(line):
        for nm in m.group(1).split(','):
            nm = nm.strip()
            if nm and current_label:
                lean_index[nm] = current_label

if not lean_index:
    sys.exit(0)  # nothing cited yet -- vacuous.

hits = []  # (file, name, label)
for f in staged_files:
    try:
        staged_blob = subprocess.run(
            ["git", "show", f":{f}"], capture_output=True, text=True,
            check=True,
        ).stdout
    except subprocess.CalledProcessError:
        continue
    declared = set()
    for line in staged_blob.splitlines():
        m = DECL_NAME_RE.match(line)
        if m:
            declared.add(m.group(1))
    for nm, label in lean_index.items():
        # Namespace-agnostic match: the full \lean{} name, or just its
        # tail component after the last dot (declarations inside a
        # matching `namespace ... end` block are written bare in
        # source) -- C2-H2 item 5 hardening: the previous "strip only
        # the outermost NeSyCat. prefix" form missed a doubly-nested
        # name like `NeSyCat.BoolW.instBLatCSRng` (source only ever
        # writes the bare `instBLatCSRng`), silently under-matching
        # relative to the plugin twin.
        tail = nm.rsplit(".", 1)[-1]
        if nm in declared or tail in declared:
            hits.append((f, nm, label))

if not hits:
    sys.exit(0)

print("commit-msg: FEEDBACK-LOOP LAW VIOLATED", file=sys.stderr)
print("", file=sys.stderr)
print("This commit touches a Lean declaration cited by a blueprint \\lean{}", file=sys.stderr)
print("mark, but blueprint/src/content.tex is not staged and the commit", file=sys.stderr)
print("message has no 'Blueprint-sync:' line. Affected item(s):", file=sys.stderr)
for f, nm, label in hits:
    print(f"  - {f}: {nm}  (blueprint item {label})", file=sys.stderr)
print("", file=sys.stderr)
print("Two ways to satisfy the law:", file=sys.stderr)
print("  1. git add blueprint/src/content.tex (tighten the item's text", file=sys.stderr)
print("     against the formalized form) and amend/redo this commit.", file=sys.stderr)
print("  2. If nothing the blueprint text needs to reflect actually", file=sys.stderr)
print("     changed (whitespace/comment-only edit, a golf pass with no", file=sys.stderr)
print("     statement change), add a commit-message line starting", file=sys.stderr)
print("     'Blueprint-sync: <reason>' documenting the justified skip.", file=sys.stderr)
sys.exit(1)
PYEOF
