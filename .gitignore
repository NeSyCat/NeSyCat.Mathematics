/.lake

# Orchestration state for the foreman/worker harness — never committed.
/.foreman/

# Transient/local Claude Code state — settings.json itself IS committed.
.claude/grind-mode
.claude/settings.local.json
__pycache__/

# leanblueprint build outputs (sources live in blueprint/src/)
blueprint/print/
blueprint/web/
blueprint/lean_decls
blueprint/src/web.paux
blueprint/src/print.*

# Agent worktrees (transient; created by isolated subagent runs)
.claude/worktrees/
