#!/usr/bin/env bash
# hooks/commit-msg — the feedback-loop absolute blocker (generic twin).
#
# Law: touching a Lean declaration that a blueprint item cites via
# \lean{} closes that item's Lean side, and per the post-\leanok
# work-loop step the blueprint text must then be tightened against the
# formalized form. This hook makes that duty a hard commit-time gate
# rather than a hoped-for habit, for any host repo carrying a
# leanblueprint `blueprint/src/content.tex` as its canonical library
# document.
#
# Rejects the commit (exit 1) when ALL of the following hold:
#   - the STAGED diff touches a *.lean file that declares a name cited
#     by a \lean{...} mark in blueprint/src/content.tex,
#   - blueprint/src/content.tex is NOT itself staged in this commit, and
#   - the commit message contains no line starting with "Blueprint-sync:".
#
# Two ways to satisfy the law:
#   1. Stage the corresponding blueprint/src/content.tex edit alongside
#      the Lean change (the normal case: the item's text is now
#      tightened).
#   2. If the Lean edit truly does not change anything the blueprint
#      text needs to reflect (e.g. a whitespace/comment-only edit, a
#      golf pass with no statement change), add a commit-message line
#      starting "Blueprint-sync: <reason>" documenting the justified
#      skip -- the same convention as a justified never-lose-work
#      line-count decrease.
#
# SECOND LAW (generic twin, C2-E6 STRUCTURE-MIRROR ENFORCEMENT): for a
# host repo that mirrors its blueprint's \section/\subsection tree onto
# its Lean source tree, every \section/\subsection may carry a trailing
# `% lean-dir: <path>` tag naming its Lean-source folder (relative to
# the repo's single auto-discovered Lean source root -- the lone
# top-level directory containing any *.lean file, skipping VCS/build/
# tooling directories; ambiguous or absent, this law simply no-ops,
# since it is opt-in convention, not every leanblueprint repo's own).
# When tags ARE present, every tagged path must exist as a folder and
# every folder under the Lean root must be tagged by some section --
# pure text + filesystem, no Lean elaboration.
#
# Host repos that want this gate: copy this file to
# .git/hooks/commit-msg and chmod +x it (a repo's own hook install is
# never done automatically by a plugin). Repos without a
# blueprint/src/content.tex simply see this hook no-op (exit 0).
#
# Args: $1 = path to a file containing the proposed commit message.

set -uo pipefail

# Resolve the repo root from wherever git invokes this hook (git sets cwd
# to the repo root for commit-msg, but resolve defensively via git itself
# rather than assuming).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi
cd "$REPO_ROOT"

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  # Can't inspect the message; don't block on a plumbing error.
  exit 0
fi

command -v python3 >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

CONTENT_TEX="$REPO_ROOT/blueprint/src/content.tex"
[ -f "$CONTENT_TEX" ] || exit 0  # no blueprint here -- nothing to enforce.

# LAW 2: STRUCTURE-MIRROR (generic twin). Runs unconditionally
# (independent of the feedback-loop law below and its exit-0
# short-circuits), against the working tree. No-ops (never blocks) when
# no section carries any `% lean-dir:` tag at all -- opt-in convention.
python3 - "$CONTENT_TEX" "$REPO_ROOT" << 'PYEOF'
import os
import re
import sys

content_tex, repo_root = sys.argv[1], sys.argv[2]

STRUCTURE_MIRROR_RE = re.compile(
    r"^\\(section|subsection)\{([^}]*)\}"
    r"(?:\s*%\s*lean-dir:\s*(\S+))?\s*$")

sections = []  # (kind, title, tag)
with open(content_tex, encoding="utf-8", errors="replace") as fh:
    for line in fh:
        m = STRUCTURE_MIRROR_RE.match(line.rstrip("\n"))
        if m:
            sections.append(m.groups())

if not any(tag is not None for _k, _t, tag in sections):
    sys.exit(0)  # opt-in convention unused by this repo -- vacuous.

# Auto-discover the Lean source root: the lone top-level directory
# (excluding VCS/build/tooling directories) containing any *.lean file.
SKIP = {".git", ".lake", "lake-packages", "build", "blueprint", "scripts",
        ".github", ".claude", "plugin", ".venvs", ".foreman"}
candidates = []
for entry in sorted(os.listdir(repo_root)):
    if entry.startswith(".") or entry in SKIP:
        continue
    p = os.path.join(repo_root, entry)
    if not os.path.isdir(p):
        continue
    found = False
    for _dirpath, _dirnames, filenames in os.walk(p):
        if any(f.endswith(".lean") for f in filenames):
            found = True
            break
    if found:
        candidates.append(entry)

if len(candidates) != 1:
    sys.exit(0)  # ambiguous/no Lean root -- can't check, don't block.
lean_root = os.path.join(repo_root, candidates[0])

violations = []
declared = set()
for kind, title, tag in sections:
    if tag is None:
        violations.append(
            f"untagged section: \\{kind}{{{title}}} carries no "
            "'% lean-dir: <path>' tag")
        continue
    if tag == "-":
        continue
    declared.add(tag)
    if not os.path.isdir(os.path.join(lean_root, tag)):
        violations.append(
            f"tagged-but-missing folder: \\{kind}{{{title}}} tags "
            f"'{tag}' but {candidates[0]}/{tag}/ does not exist")

for dirpath, dirnames, _filenames in os.walk(lean_root):
    dirnames[:] = [d for d in dirnames if not d.startswith(".")]
    rel = os.path.relpath(dirpath, lean_root)
    if rel == ".":
        continue
    rel = rel.replace(os.sep, "/")
    if rel not in declared:
        violations.append(
            f"orphan folder: {candidates[0]}/{rel}/ has no matching "
            "'% lean-dir:' tag in content.tex")

if violations:
    print("commit-msg: STRUCTURE-MIRROR LAW VIOLATED", file=sys.stderr)
    print("", file=sys.stderr)
    for v in violations:
        print(f"  - {v}", file=sys.stderr)
    print("", file=sys.stderr)
    print("Fix content.tex's '% lean-dir:' tags or the Lean folder tree", file=sys.stderr)
    print("so they mirror each other exactly, then redo this commit.", file=sys.stderr)
    sys.exit(1)
sys.exit(0)
PYEOF
STRUCTURE_MIRROR_STATUS=$?
if [ "$STRUCTURE_MIRROR_STATUS" -ne 0 ]; then
  exit "$STRUCTURE_MIRROR_STATUS"
fi

# 1. Staged Lean files, added/copied/modified/renamed.
STAGED_LEAN=()
while IFS= read -r line; do
  [ -n "$line" ] && STAGED_LEAN+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.lean' 2>/dev/null)

if [ "${#STAGED_LEAN[@]}" -eq 0 ]; then
  exit 0  # no Lean touched -- law doesn't apply.
fi

# 2. content.tex itself staged -> satisfied.
if git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -qF "blueprint/src/content.tex"; then
  exit 0
fi

# 3. Blueprint-sync: line in the message -> satisfied.
if grep -qE '^Blueprint-sync:' "$MSG_FILE"; then
  exit 0
fi

# 4. Does any staged Lean file declare a name cited by \lean{} in
#    content.tex? Use the STAGED blob content (git show :path), not the
#    working tree, so an unstaged further edit can't hide a violation.
python3 - "$CONTENT_TEX" "${STAGED_LEAN[@]}" << 'PYEOF'
import re
import subprocess
import sys

content_tex = sys.argv[1]
staged_files = sys.argv[2:]

TEX_LABEL_RE = re.compile(r"\\label\{([^}]*)\}")
TEX_LEAN_RE = re.compile(r"\\lean\{([^}]*)\}")
DECL_NAME_RE = re.compile(
    r"^(?:noncomputable\s+|private\s+|protected\s+)*"
    r"(?:def|abbrev|theorem|lemma|structure|class|instance)\s+"
    r"([A-Za-z_][A-Za-z0-9_.']*)")

with open(content_tex, encoding="utf-8", errors="replace") as fh:
    tex_lines = fh.readlines()

lean_index = {}  # name -> label
current_label = None
for line in tex_lines:
    lm = TEX_LABEL_RE.search(line)
    if lm:
        current_label = lm.group(1)
    for m in TEX_LEAN_RE.finditer(line):
        for nm in m.group(1).split(','):
            nm = nm.strip()
            if nm and current_label:
                lean_index[nm] = current_label

if not lean_index:
    sys.exit(0)  # nothing cited yet -- vacuous.

hits = []  # (file, name, label)
for f in staged_files:
    try:
        staged_blob = subprocess.run(
            ["git", "show", f":{f}"], capture_output=True, text=True,
            check=True,
        ).stdout
    except subprocess.CalledProcessError:
        continue
    declared = set()
    for line in staged_blob.splitlines():
        m = DECL_NAME_RE.match(line)
        if m:
            declared.add(m.group(1))
    for nm, label in lean_index.items():
        # Namespace-agnostic match: the full \lean{} name, or just its
        # tail component after the last dot (declarations inside a
        # matching `namespace ... end` block are written bare).
        tail = nm.rsplit(".", 1)[-1]
        if nm in declared or tail in declared:
            hits.append((f, nm, label))

if not hits:
    sys.exit(0)

print("commit-msg: FEEDBACK-LOOP LAW VIOLATED", file=sys.stderr)
print("", file=sys.stderr)
print("This commit touches a Lean declaration cited by a blueprint \\lean{}", file=sys.stderr)
print("mark, but blueprint/src/content.tex is not staged and the commit", file=sys.stderr)
print("message has no 'Blueprint-sync:' line. Affected item(s):", file=sys.stderr)
for f, nm, label in hits:
    print(f"  - {f}: {nm}  (blueprint item {label})", file=sys.stderr)
print("", file=sys.stderr)
print("Two ways to satisfy the law:", file=sys.stderr)
print("  1. git add blueprint/src/content.tex (tighten the item's text", file=sys.stderr)
print("     against the formalized form) and amend/redo this commit.", file=sys.stderr)
print("  2. If nothing the blueprint text needs to reflect actually", file=sys.stderr)
print("     changed (whitespace/comment-only edit, a golf pass with no", file=sys.stderr)
print("     statement change), add a commit-message line starting", file=sys.stderr)
print("     'Blueprint-sync: <reason>' documenting the justified skip.", file=sys.stderr)
sys.exit(1)
PYEOF
